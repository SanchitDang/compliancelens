FLOCI_STORAGE_MODE=hybrid
FLOCI_STORAGE_PERSISTENT_PATH=/app/data
FLOCI_SERVICES_IAM_ENFORCEMENT_ENABLED=true

RAW_BUCKET=
INTERMEDIATE_BUCKET=
FLOCI_SERVICES_LAMBDA_DOCKER_FLAGS=--volume ${PWD}/.env:/run/compliancelens/.env:ro
