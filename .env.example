LLM_BACKEND=azure
EMBEDDING_BACKEND=azure
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=16
LLM_MAX_OUTPUT_TOKENS=2048
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDINGS_API_VERSION=2024-04-01-preview
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
BEDROCK_CHAT_MODEL=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ca-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DATABASE_USER=compliancelens
DATABASE_PASSWORD=local-development-only
DATABASE_NAME=compliancelens
DATABASE_HOST=localhost
DATABASE_PORT=7001
VECTOR_TABLE=regulatory_chunks_azure
CHUNK_SIZE_BYTES=1500
CHUNK_OVERLAP_BYTES=200
PII_SPACY_MODEL=en_core_web_sm
INGEST_MAX_EMBEDDING_BATCHES=40
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.30
QUERY_MAX_BYTES=2000
FLOCI_IMAGE=floci/floci:latest
FLOCI_HOSTNAME=floci
